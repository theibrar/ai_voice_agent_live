# App Configuration
PORT=8080
ENV=development

# Database Configuration (Postgres 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chatbot_db
DB_SSLMODE=disable

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
