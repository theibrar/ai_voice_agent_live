# JWT Authentication Configuration (For Phase 2)
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRATION_HOURS=24

# PgAdmin Configuration
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050